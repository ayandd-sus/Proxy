# AITUNNEL API key (keep private; do not paste this into SillyTavern)
AITUNNEL_API_KEY=sk-aitunnel-replace-me

# Separate password used by SillyTavern to authenticate to this local proxy.
# Generate a random value, for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROXY_API_KEY=replace-with-a-long-random-secret

# AITUNNEL's unified API base. It must end in /v1 (no trailing slash).
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Keep loopback unless SillyTavern runs in another container/device.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# How the proxy marks the cache breakpoint for Claude:
#   auto    - top-level cache_control; AITUNNEL puts the breakpoint on the last
#             cacheable block. Best when the whole prompt is stable.
#   history - explicit cache_control on the message before the newest one, so the
#             cached prefix excludes the newest message. Use this when SillyTavern
#             appends a large block to the newest user message and moves it each turn
#             (PREFIX_DIFF_LOG shows "REWRITTEN at msg[N] role=user" with the newest
#             message shrinking on the next request).
#   off     - no proxy-added marker.
CACHE_MODE=auto
CACHE_TTL=5m

# Add a stable, opaque AITUNNEL session_id for provider affinity.
SESSION_AFFINITY=on

# Optional: pin the session_id to a fixed value instead of deriving it.
# AITUNNEL keeps each prompt cache at one provider, so a value that never changes gives
# the most reliable affinity. Use one value per SillyTavern instance. Max 256 chars.
# SESSION_ID=my-sillytavern-aitunnel-session

# Diagnostic only: log whether the cached prefix changed between consecutive
# requests, and flag a changing session_id. Keeps short hashes of the previous
# request in memory; never stores prompt text. Off by default.
PREFIX_DIFF_LOG=off

# Request safety limits / upstream timeout.
MAX_BODY_BYTES=134217728
UPSTREAM_TIMEOUT_MS=600000
